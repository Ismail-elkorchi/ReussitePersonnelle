{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": false,
			"palette": [
				{
					"slug": "ink",
					"color": "#1b1b1f",
					"name": "Ink"
				},
				{
					"slug": "paper",
					"color": "#ffffff",
					"name": "Paper"
				},
				{
					"slug": "muted",
					"color": "#f3f5f7",
					"name": "Muted"
				},
				{
					"slug": "accent",
					"color": "#d43f3a",
					"name": "Accent"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "2"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "3"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "4"
				},
				{
					"slug": "50",
					"size": "2.5rem",
					"name": "5"
				},
				{
					"slug": "60",
					"size": "4rem",
					"name": "6"
				}
			],
			"units": ["px", "rem", "%", "vh", "vw"]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "system",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "System"
				},
				{
					"slug": "serif",
					"fontFamily": "Georgia, \"Times New Roman\", serif",
					"name": "Serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "2.25rem",
					"name": "Extra Large"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		}
	}
}
