COMPOSE_PROJECT_NAME=reussitepersonnelle

LOCAL_HTTP_PORT=8080
LOCAL_PHPMYADMIN_PORT=8081
LOCAL_URL=http://localhost:8080
PRODUCTION_URL=https://reussitepersonnelle.com

WORDPRESS_VERSION=7.0
PHP_VERSION=8.4
MARIADB_VERSION=10.11.16

LOCAL_DB_NAME=wordpress
LOCAL_DB_USER=wordpress
LOCAL_DB_PASSWORD=wordpress
LOCAL_DB_ROOT_PASSWORD=password

WP_DEBUG=true

# Required for `npm run local:pull`.
# Keep real production values only in ignored `local/.env`.
RP_SSH_TARGET=
RP_DOMAIN=reussitepersonnelle.com
RP_REMOTE_DOCROOT=
RP_REMOTE_DB_DUMP_COMMAND=

# Optional. If empty, `npm run local:import` detects the prefix from the SQL dump.
LOCAL_TABLE_PREFIX=
